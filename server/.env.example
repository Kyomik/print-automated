# Copy this file to .env and set the same API_TOKEN in the print client.
PORT=3000
API_TOKEN=replace-with-your-user-specific-token
MAX_PAYLOAD_MB=50

# Enable ClamAV attachment scanning only when a ClamAV service is available.
ENABLE_CLAMAV=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=false
